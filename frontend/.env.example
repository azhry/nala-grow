# Optional server-side Vault configuration. These values are read only by
# frontend/next.config.js during the Node.js build/configuration process.
VAULT_ADDR=
VAULT_KV_MOUNT=secret
VAULT_KV_PATH=nala-labs/nala-grow

# Choose one authentication method when VAULT_ADDR is set:
VAULT_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# Used only when VAULT_ADDR is unset (local development fallback).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
