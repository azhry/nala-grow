# Copy this file to .vault-config and fill it from a protected secret source.
# The real .vault-config is ignored and must never be committed.
VAULT_ADDR=https://vault.nalanirvana.com
VAULT_TOKEN=
VAULT_KV_MOUNT=secret
VAULT_KV_PATH=nala-labs/nala-grow

# Alternatively, omit VAULT_TOKEN and provide both AppRole values.
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
