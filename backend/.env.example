PORT=4000
DATABASE_URL=postgres://nalagrow:nalagrow@localhost:5432/nalagrow?sslmode=disable
ALLOWED_ORIGIN=http://localhost:3000
JWT_SECRET=dev-secret-change-in-production

# Optional dependency addresses used by GET /healthz.
CASDOOR_ISSUER=
# Casdoor IAM is enabled only when this flag is true (or all required client
# values are present). Keep client secret/admin token in Vault.
CASDOOR_ENABLED=false
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
CASDOOR_ORGANIZATION=
CASDOOR_APPLICATION=
CASDOOR_AUDIENCE=
CASDOOR_REDIRECT_URI=http://localhost:3000/auth/callback
CASDOOR_ADMIN_TOKEN=
VAULT_ADDR=
MONGODB_ADDR=
MONGODB_URI=
REDIS_ADDR=
REDIS_URL=
KAFKA_ADDR=
KAFKA_BROKERS=
HEALTHCHECK_TIMEOUT=2s

# When VAULT_ADDR is set, application configuration is loaded from Vault KV v2.
# Provide either VAULT_TOKEN or both AppRole values. Never commit real values.
VAULT_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_KV_MOUNT=secret
VAULT_KV_PATH=nala-labs/nala-grow
